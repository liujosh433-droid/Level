# =============================================================================
# Level — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every setting is also overridable via a real environment variable of the
# same name (see packages/core/src/level_core/config.py).

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# "local"  = in-memory fakes + AI Studio Gemini key (fast unit tests / offline)
# "cloud"  = Firestore + (optional) Vertex Vector Search + Model Armor
#
# For a real parent test that survives API restarts, use LEVEL_ENV=cloud with
# LEVEL_VECTOR_BACKEND=firestore (Vertex index deploy is optional).
LEVEL_ENV=local
LEVEL_SERVICE_NAME=level
LEVEL_USE_AI_STUDIO=true
LEVEL_VECTOR_BACKEND=firestore

# -----------------------------------------------------------------------------
# Google Cloud
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=project-c31bdcdc-f293-47c2-a4c
GOOGLE_CLOUD_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Gemini access
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=

LEVEL_REASONING_MODEL=gemini-3.5-flash
LEVEL_FAST_MODEL=gemini-3.5-flash
LEVEL_LIVE_MODEL=gemini-3.5-flash-live-preview
LEVEL_EMBEDDING_MODEL=gemini-embedding-001
LEVEL_EMBEDDING_DIMENSIONS=768

# -----------------------------------------------------------------------------
# Memory Bank
# -----------------------------------------------------------------------------
LEVEL_FIRESTORE_DATABASE=(default)

# Vertex AI Vector Search — only needed when LEVEL_VECTOR_BACKEND=vertex
LEVEL_VECTOR_INDEX_ID=
LEVEL_VECTOR_INDEX_ENDPOINT_ID=
LEVEL_VECTOR_DEPLOYED_INDEX_ID=level_signals_deployed

# -----------------------------------------------------------------------------
# Model Armor
# -----------------------------------------------------------------------------
LEVEL_MODEL_ARMOR_TEMPLATE_INBOUND=projects/project-c31bdcdc-f293-47c2-a4c/locations/us-central1/templates/level-inbound
LEVEL_MODEL_ARMOR_TEMPLATE_OUTBOUND=projects/project-c31bdcdc-f293-47c2-a4c/locations/us-central1/templates/level-outbound

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LEVEL_OTEL_EXPORTER=console

# -----------------------------------------------------------------------------
# Google OAuth (end-user Calendar)
# -----------------------------------------------------------------------------
# Create a Web application OAuth client in GCP Console → APIs & Services →
# Credentials. Authorized redirect URI must match exactly:
#   http://localhost:8080/v1/auth/google/callback
# (After Google returns here, Level hands the session to :3000 via /v1/auth/handoff.)
# Enable: Google Calendar API
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback
LEVEL_WEB_APP_URL=http://localhost:3000
# Public HTTPS API URL for Google Calendar push (leave blank on localhost).
# Example: https://api.yourdomain.com  or an ngrok/cloudflare tunnel to :8080
# LEVEL_PUBLIC_API_URL=

# Stable cookie signing (set once; don't leave blank in shared/dev machines).
# LEVEL_SESSION_SECRET=pick-a-long-random-string

# Optional absolute API URL for SSR; browser always uses same-origin /v1 via rewrite.
# NEXT_PUBLIC_LEVEL_API_URL=http://127.0.0.1:8080
# LEVEL_API_PROXY_TARGET=http://127.0.0.1:8080
