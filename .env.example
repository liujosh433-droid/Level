# =============================================================================
# Level v2 - environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every setting is also overridable via a real environment variable of the
# same name (see packages/core/src/level_core/config.py).

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# local   -> .level/local_store/*.json (offline dev, no GCP needed)
# cloud   -> Firestore + Vertex AI + Cloud Logging
LEVEL_ENV=local
LEVEL_SERVICE_NAME=level
LEVEL_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Google Cloud (only required when LEVEL_ENV=cloud)
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
LEVEL_FIRESTORE_DATABASE=(default)

# -----------------------------------------------------------------------------
# Gemini backend selection (hackathon rule: Gemini 3.5+ via Gemini API OR Vertex AI)
# -----------------------------------------------------------------------------
# EASIEST PATH (recommended for hackathon):
#   Get a free key at https://aistudio.google.com/apikey and set GOOGLE_API_KEY.
#   When set, Level uses the Gemini API (AI Studio) directly and gets 3.5-flash
#   without any Vertex Model Garden setup.
GOOGLE_API_KEY=
#
# VERTEX PATH (used automatically when GOOGLE_API_KEY is blank):
#   Requires GOOGLE_CLOUD_PROJECT + ADC AND the model must be enabled in your
#   project's Vertex Model Garden. Many projects still only have 2.5 enabled;
#   check with `curl` first or use the AI Studio path above.
#
LEVEL_MODEL_PRO=gemini-3.5-flash
LEVEL_MODEL_FLASH=gemini-3.5-flash
# Optional fallback classifier for the ActivityAgent (+0.2 hackathon bonus).
LEVEL_MODEL_GEMMA=gemma-3-4b-it

# -----------------------------------------------------------------------------
# Calendar sync window (first-class knob per gameplan)
# -----------------------------------------------------------------------------
LEVEL_CAL_DAYS_BACK=14
LEVEL_CAL_DAYS_FORWARD=28

# -----------------------------------------------------------------------------
# Cost & rate guardrails (agents/gate.py)
# -----------------------------------------------------------------------------
LEVEL_DAILY_COST_CAP_USD=2.00
LEVEL_USER_RATE_PER_HOUR=60
LEVEL_USER_RATE_PER_DAY=500

# -----------------------------------------------------------------------------
# Prod demo mode (only meaningful when LEVEL_ENV=cloud)
# -----------------------------------------------------------------------------
# When true, POST /v1/auth/demo works against the deployed API too, so
# judges can hit the live URL and land in a synthetic user's world
# without cloning the repo. Off by default because a naive
# implementation would let bots spawn unbounded synthetic users
# against real Firestore + Vertex billing.
#
# Safety when enabled:
#   * Fixed pool of LEVEL_DEMO_SLOTS_PER_SCENARIO user_ids per
#     scenario. Client IP is SHA-256 hashed to a slot, so the same
#     judge lands on the same demo user every click while the total
#     user population stays bounded at slots * len(scenarios).
#   * Per-IP token bucket (LEVEL_DEMO_PER_IP_PER_HOUR) rejects burst
#     abuse of the demo endpoint itself.
#   * Per-user daily cost cap (LEVEL_DAILY_COST_CAP_USD, above) still
#     applies, capping LLM spend at cap * pool_size in the worst
#     case.
LEVEL_DEMO_IN_CLOUD=false
LEVEL_DEMO_SLOTS_PER_SCENARIO=3
LEVEL_DEMO_PER_IP_PER_HOUR=10

# -----------------------------------------------------------------------------
# Google OAuth (end-user Calendar + Gmail)
# -----------------------------------------------------------------------------
# Create a Web application OAuth client in GCP Console -> APIs & Services ->
# Credentials. Enable Google Calendar API + Gmail API and list the scopes
# calendar / calendar.events / gmail.send on the OAuth consent screen.
#
# Authorized redirect URIs: register the small set below at once so port
# collisions never require a Console update.
#   http://localhost:8080/v1/auth/google/callback   (default)
#   http://localhost:8081/v1/auth/google/callback   (Cursor collision fallback)
#   http://localhost:8000/v1/auth/google/callback   (common alt)
#
# GOOGLE_OAUTH_REDIRECT_URI can stay unset - it auto-derives from
# LEVEL_API_PORT (default 8080). Override it only for cloud deploys where
# the redirect URI is your HTTPS Cloud Run URL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
LEVEL_WEB_APP_URL=http://localhost:3000

# Local dev API port. Override to sidestep collisions (Cursor grabs 8080 by
# default). The Next.js proxy, OAuth redirect URI, and Makefile all follow
# from this single value.
# LEVEL_API_PORT=8080

# Public HTTPS API URL for Google Calendar push webhooks. Blank on localhost:
# Today pulls calendar deltas on each load (local substitute). In prod set to
# https://api.<yourdomain> or an ngrok/cloudflare tunnel to :8080.
# LEVEL_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Sessions (cookies)
# -----------------------------------------------------------------------------
# Generate one long random string; rotate via Secret Manager in cloud.
LEVEL_SESSION_SECRET=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# console | cloud
LEVEL_OTEL_EXPORTER=console
LEVEL_ADMIN_TRACES_ENABLED=true

# -----------------------------------------------------------------------------
# Web frontend (optional overrides)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_LEVEL_API_URL=http://127.0.0.1:8080
# LEVEL_API_PROXY_TARGET=http://127.0.0.1:8080
