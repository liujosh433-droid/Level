# Environments and credentials
.env
.env.*
!.env.example
.level/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
# .terraform.lock.hcl is intentionally checked in — Terraform's
# reproducibility contract requires the lock file to be version-
# controlled so every apply pins the same provider versions.
service-account*.json
*.pem

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Next
node_modules/
.next/
.turbo/
out/
.vercel/
playwright-report/
test-results/

# Tooling caches
.DS_Store
.tools/
*.tsbuildinfo

# Terraform vars can contain project ids, service accounts, and secrets
infra/terraform/terraform.tfvars

# Editor
.vscode/
.idea/
*.swp

# Local bundled tools stay usable but their caches don't need version-control
